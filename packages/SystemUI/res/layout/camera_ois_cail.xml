<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="700dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tips_title"
            android:layout_marginTop="10dp"
            android:text="@string/camera_ois_calibration_title1"
            android:textSize="21sp"
            android:textColor="#de000000"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:fontFamily="sans-serif"
            />

        <View
            android:layout_marginTop="10dp"
            android:background="#de000000"
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <TextView
            android:id="@+id/tips_message"
            android:layout_marginTop="40dp"
            android:text="@string/camera_ois_calibration_message1"
            android:textSize="16sp"
            android:textColor="#de000000"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:fontFamily="sans-serif"
            />

        <Button android:id="@+id/tips_ok"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_appops_ok"
            android:visibility="visible"/>


    </LinearLayout>



</RelativeLayout>
